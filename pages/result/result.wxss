.result {
  padding: 32rpx;
  background: #f8fbff;
  min-height: 100vh;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #0f9d58, #34c47c);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 32rpx;
  text-align: center;
}

.hero-title {
  font-size: 28rpx;
  opacity: 0.9;
}

.hero-distance {
  font-size: 80rpx;
  font-weight: 700;
}

.hero-mode {
  font-size: 26rpx;
  opacity: 0.8;
}

.metrics {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 24rpx;
}

.metric {
  text-align: center;
  flex: 1;
}

.label {
  font-size: 24rpx;
  color: #888;
}

.value {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.map-card {
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.07);
}

.map-card map {
  width: 100%;
  height: 100%;
}

.leaderboard {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.05);
}

.leaderboard-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.leaderboard-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.rank {
  width: 44rpx;
  color: #aaa;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin: 0 16rpx;
}

.info {
  flex: 1;
}

.name {
  font-size: 28rpx;
}

.distance {
  font-size: 26rpx;
  color: #0f9d58;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  height: 90rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  border: none;
}

.btn.primary {
  background: linear-gradient(135deg, #0f9d58, #34c47c);
  color: #fff;
}

.btn.secondary {
  background: #fff;
  border: 2rpx solid #0f9d58;
  color: #0f9d58;
}

.empty {
  text-align: center;
  padding-top: 200rpx;
  color: #999;
}
