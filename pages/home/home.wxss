.home {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(180deg, #f4fff8 0%, #ffffff 30%);
  padding: 28rpx 24rpx 120rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.decor-bubble {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  filter: blur(0.5px);
  opacity: 0.35;
}

.decor-bubble-left {
  top: -60rpx;
  left: -40rpx;
  background: radial-gradient(circle, #b9f5cf, #7be0a7);
}

.decor-bubble-right {
  top: 120rpx;
  right: -80rpx;
  background: radial-gradient(circle, #ffd0ec, #f7a4d1);
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #4b4b4b;
  margin-bottom: 16rpx;
}

.gps {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e6f8ee;
  color: #0f9d58;
}

.gps-warn {
  background: #fff7e6;
  color: #ffb020;
}

.scope {
  color: #0f9d58;
  font-weight: 500;
}

.map-card {
  position: relative;
  height: 420rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 40rpx rgba(15, 157, 88, 0.12);
  margin-bottom: 24rpx;
}

.map-card map {
  width: 100%;
  height: 100%;
}

.map-overlay {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 24rpx;
}

.summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.summary-item {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx;
  box-shadow: 0 18rpx 36rpx rgba(15, 157, 88, 0.12);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.summary-item .label {
  font-size: 26rpx;
  color: #616161;
  letter-spacing: 1rpx;
}

.summary-item .value {
  font-size: 42rpx;
  font-weight: 700;
  color: #111;
}

.summary-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.summary-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #e3ffe7, #d9f6ff);
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.08);
}

.summary-icon-sun {
  background: linear-gradient(135deg, #ffe29f, #ffa99f);
}

.summary-icon-week {
  background: linear-gradient(135deg, #a1c4fd, #c2e9fb);
}

.summary-icon-month {
  background: linear-gradient(135deg, #d4fc79, #96e6a1);
}

.summary-icon-streak {
  background: linear-gradient(135deg, #fbc2eb, #a6c1ee);
}

.mode-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.mode-tab {
  flex: 1 1 45%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 34rpx rgba(15, 157, 88, 0.1);
  color: #525252;
  min-height: 160rpx;
}

.mode-tab.active {
  background: linear-gradient(135deg, #0f9d58, #34c47c);
  color: #fff;
  transform: translateY(-4rpx);
  box-shadow: 0 20rpx 40rpx rgba(15, 157, 88, 0.25);
}

.mode-label {
  font-size: 34rpx;
  font-weight: 600;
}

.mode-desc {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 12rpx;
}

.go-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.go-btn {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #5ae09e, #0f9d58);
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
  border: none;
  line-height: 220rpx;
  box-shadow: 0 25rpx 40rpx rgba(15, 157, 88, 0.35);
}

.leaderboard-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 18rpx 32rpx rgba(0, 0, 0, 0.05);
}

.leaderboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.more {
  font-size: 24rpx;
  color: #0f9d58;
}

.leaderboard-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f8fbf9;
  margin-bottom: 14rpx;
}

.rank {
  width: 42rpx;
  font-size: 28rpx;
  color: #a8a8a8;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 16rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 28rpx;
  color: #333;
}

.distance {
  font-size: 24rpx;
  color: #0f9d58;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e6f8ee;
  color: #0f9d58;
  font-size: 22rpx;
}

.login-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.login-card {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, 0.25);
}

.login-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f9d58;
}

.login-desc {
  display: block;
  margin: 24rpx 0 40rpx;
  font-size: 26rpx;
  color: #666;
}

.login-btn {
  width: 100%;
  margin-bottom: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0f9d58, #34c47c);
  color: #fff;
  border: none;
}

.login-skip {
  color: #8c8c8c;
  font-size: 26rpx;
  background: transparent;
}
